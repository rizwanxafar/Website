// src/components/CategoryPanel.jsx
"use client";

import Link from "next/link";
import { useState } from "react";

export default function CategoryPanel({ title, items, defaultOpen = false }) {
  const [isOpen, setIsOpen] = useState(defaultOpen);

  return (
    <div className="rounded-xl border border-slate-200 bg-white transition hover:shadow-md">
      <button
        type="button"
        onClick={() => setIsOpen((v) => !v)}
        className="w-full p-6 text-left flex items-center justify-between gap-4"
        aria-expanded={isOpen}
        aria-controls={`panel-${slugify(title)}`}
      >
        <span className="text-lg font-semibold text-slate-900">{title}</span>
        <span
          className={`inline-flex h-8 w-8 items-center justify-center rounded-lg border transition
            ${isOpen ? "bg-brand text-white border-brand" : "bg-white border-slate-300 text-slate-600"}`}
          aria-hidden="true"
        >
          {isOpen ? "–" : "+"}
        </span>
      </button>

      <div
        id={`panel-${slugify(title)}`}
        className={`overflow-hidden transition-[max-height] duration-300 ease-in-out ${
          isOpen ? "max-h-96" : "max-h-0"
        }`}
      >
        <ul className="px-6 pb-6 space-y-2">
          {items.map((item) => (
            <li key={item.href}>
              <Link
                href={item.href}
                className="block rounded-lg px-4 py-3 text-sm font-medium border border-slate-200 text-slate-800 hover:border-brand/30 hover:text-brand hover:bg-brand/5 transition-colors"
              >
                {item.label}
              </Link>
            </li>
          ))}
        </ul>
      </div>
    </div>
  );
}

function slugify(s) {
  return String(s).toLowerCase().replace(/\s+/g, "-").replace(/[^a-z0-9-]/g, "");
}
